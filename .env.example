# ---------------------------------------------------------------------------
# FreelanceHub frontend — environment template. Copy to `.env.local` and edit.
# ---------------------------------------------------------------------------

# Base URL of the Express API. The default `/api` value is served by the Vite
# dev proxy (see vite.config.js) so cookies stay first-party in development.
VITE_API_URL=/api

# Where the dev proxy forwards `/api` requests.
VITE_PROXY_TARGET=http://localhost:5000

# `live`   -> talk to the real Express + MongoDB backend
# `mock`   -> serve the deterministic in-browser demo dataset (no backend needed)
VITE_API_MODE=live

# Artificial latency (ms) added by the mock adapter so loading states are visible.
VITE_MOCK_LATENCY=380

# Feature flags (true/false). See src/config/features.ts
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_SERVICE_WORKER=false
VITE_ENABLE_REALTIME=true
